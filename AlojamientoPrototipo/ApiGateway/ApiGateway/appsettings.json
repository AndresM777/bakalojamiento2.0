            "PathPattern": "/api/v1/facturas-lucano/{**remainder}"
          }
        ]
      },
      "metodospago-route": {
        "ClusterId": "facturacion-cluster",
        "Match": {
          "Path": "/api/v1/metodospago-lucano/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/v1/metodospago-lucano/{**remainder}"
          }
        ]
      }
