{
  "info": {
    "_postman_id": "alojamiento-mr-full-suite",
    "name": "AlojamientoMR - Suite Completa de Pruebas",
    "description": "Colección completa de pruebas para los 4 microservicios de AlojamientoMR. Incluye variables de entorno, flujo de autenticación automático y pruebas de todos los endpoints con los sufijos -lucano.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway_url", "value": "https://apigatway-0wjx.onrender.com", "type": "string" },
    { "key": "clientes_url", "value": "https://clientes-hudx.onrender.com", "type": "string" },
    { "key": "alojamientos_url", "value": "https://alojamiento-t2f7.onrender.com", "type": "string" },
    { "key": "reservas_url", "value": "https://reseras.onrender.com", "type": "string" },
    { "key": "facturacion_url", "value": "https://facturacione.onrender.com", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "clienteId", "value": "", "type": "string" },
    { "key": "alojamientoId", "value": "1", "type": "string" },
    { "key": "habitacionId", "value": "1", "type": "string" },
    { "key": "reservaId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "🔐 1. Autenticación (Usuarios MS)",
      "item": [
        {
          "name": "POST /auth-lucano/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.token) {",
                  "    pm.collectionVariables.set('token', body.token);",
                  "    pm.test('✅ Token guardado correctamente', () => pm.expect(body.token).to.be.a('string'));",
                  "  }",
                  "}",
                  "pm.test('✅ Login exitoso (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@alojamiento.com\",\n  \"password\": \"Admin1234!\"\n}"
            },
            "url": {
              "raw": "{{clientes_url}}/api/v1/auth-lucano/login",
              "host": ["{{clientes_url}}"],
              "path": ["api", "v1", "auth-lucano", "login"]
            },
            "description": "Autenticación de usuario. El token JWT se guarda automáticamente en la variable 'token' para las demás requests."
          }
        },
        {
          "name": "POST /clientes-lucano/registrar",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@prueba.com\",\n  \"password\": \"Test1234!\",\n  \"nombreCompleto\": \"Test Usuario\",\n  \"cedula\": \"1234567890\",\n  \"telefono\": \"0987654321\",\n  \"domicilio\": \"Calle Falsa 123\"\n}"
            },
            "url": {
              "raw": "{{clientes_url}}/api/v1/clientes-lucano/registrar",
              "host": ["{{clientes_url}}"],
              "path": ["api", "v1", "clientes-lucano", "registrar"]
            }
          }
        }
      ]
    },
